# Copy to .env.local and fill in. Never commit .env.local.

# Public URL of the live site (used for sitemap, robots and share links)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Sanity (sanity.io/manage → your project)
NEXT_PUBLIC_SANITY_PROJECT_ID=79m429dl
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-02-01
# API token with Editor permission. Server-only: saves enquiries and runs the seed script.
# Create it at https://www.sanity.io/manage/project/79m429dl/api#tokens
SANITY_API_WRITE_TOKEN=

# Contact form emails, sent through our Google Workspace mailbox (no other email service).
# SMTP_USER: the mailbox that sends them. SMTP_PASS: a Google app password for that mailbox
# (myaccount.google.com/apppasswords, with 2-Step Verification on). Server-only; never commit it.
SMTP_USER=contact@opsiogen.com
SMTP_PASS=
# Inbox that receives enquiries (comma-separate for more than one)
ENQUIRY_TO_EMAIL=contact@opsiogen.com
