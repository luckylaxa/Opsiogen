24:["$","h2","b3",{"id":"choose-a-few-content-themes","className":"mt-[1.9em] scroll-mt-[calc(var(--header-h)+24px)] text-[length:clamp(24px,calc(0.9vw+20.6px),38px)] leading-[1.15] font-medium tracking-[-0.02em] text-ink text-balance first:mt-0","children":["Choose a few content themes"]}]
25:["$","p","b4",{"className":"mt-[1.1em] first:mt-0","children":["Themes are the subjects you come back to again and again. They keep the feed varied without starting from scratch each time. Good ones to start with:"]}]
26:["$","ul","b5l0-parent",{"className":"mt-[1.1em] list-disc space-y-[0.5em] pl-[1.3em] marker:text-accent","children":[["$","li","b5l0",{"children":["Your work and what it achieved for customers"]}],["$","li","b5l1",{"children":["Answers to questions customers ask"]}],["$","li","b5l2",{"children":["How you work, behind the scenes"]}],["$","li","b5l3",{"children":["The people behind the business"]}],["$","li","b5l4",{"children":["News, launches and offers"]}]]}]
27:["$","h2","b6",{"id":"set-a-rhythm-you-can-keep","className":"mt-[1.9em] scroll-mt-[calc(var(--header-h)+24px)] text-[length:clamp(24px,calc(0.9vw+20.6px),38px)] leading-[1.15] font-medium tracking-[-0.02em] text-ink text-balance first:mt-0","children":["Set a rhythm you can keep"]}]
28:["$","p","b7",{"className":"mt-[1.1em] first:mt-0","children":["Decide how often you will post on each channel, then stick to it. A steady rhythm beats bursts of activity followed by silence. Posting less and keeping going works better than posting daily for two weeks and stopping."]}]
29:["$","h2","b8",{"id":"fill-the-calendar","className":"mt-[1.9em] scroll-mt-[calc(var(--header-h)+24px)] text-[length:clamp(24px,calc(0.9vw+20.6px),38px)] leading-[1.15] font-medium tracking-[-0.02em] text-ink text-balance first:mt-0","children":["Fill the calendar"]}]
2a:["$","p","b9",{"className":"mt-[1.1em] first:mt-0","children":["Put the anchor posts on their dates first. Then spread the themes across the remaining slots, so no subject repeats too often in a row. For each slot, write a working title and the format: a single image, a carousel, a short video or a story."]}]
2b:["$","h2","b10",{"id":"make-one-idea-work-harder","className":"mt-[1.9em] scroll-mt-[calc(var(--header-h)+24px)] text-[length:clamp(24px,calc(0.9vw+20.6px),38px)] leading-[1.15] font-medium tracking-[-0.02em] text-ink text-balance first:mt-0","children":["Make one idea work harder"]}]
2c:["$","p","b11",{"className":"mt-[1.1em] first:mt-0","children":["A strong idea can become several posts. A customer question might become a short video, a carousel that walks through the answer and a quick tip in stories. Plan them together and each idea goes further."]}]
2d:["$","h2","b12",{"id":"write-and-design-in-batches","className":"mt-[1.9em] scroll-mt-[calc(var(--header-h)+24px)] text-[length:clamp(24px,calc(0.9vw+20.6px),38px)] leading-[1.15] font-medium tracking-[-0.02em] text-ink text-balance first:mt-0","children":["Write and design in batches"]}]
2e:["$","p","b13",{"className":"mt-[1.1em] first:mt-0","children":["Write all the captions in one session and design the visuals in another. Working in batches keeps the voice and the look consistent, and leaves time for someone else to review before anything goes out."]}]
2f:["$","h2","b14",{"id":"leave-room-for-the-moment","className":"mt-[1.9em] scroll-mt-[calc(var(--header-h)+24px)] text-[length:clamp(24px,calc(0.9vw+20.6px),38px)] leading-[1.15] font-medium tracking-[-0.02em] text-ink text-balance first:mt-0","children":["Leave room for the moment"]}]
30:["$","p","b15",{"className":"mt-[1.1em] first:mt-0","children":["Keep a few slots open for what you can’t plan: news in your industry, a customer win, a question everyone is asking. A plan should give you structure, not stop you reacting."]}]
31:["$","h2","b16",{"id":"review-and-adjust","className":"mt-[1.9em] scroll-mt-[calc(var(--header-h)+24px)] text-[length:clamp(24px,calc(0.9vw+20.6px),38px)] leading-[1.15] font-medium tracking-[-0.02em] text-ink text-balance first:mt-0","children":["Review and adjust"]}]
32:["$","p","b17",{"className":"mt-[1.1em] first:mt-0","children":["At the end of the month, look at which posts started conversations, brought visits to your site or led to enquiries. Do more of what worked in next month’s plan. Likes are pleasant; enquiries matter more."]}]
33:["$","h2","b18",{"id":"how-we-help","className":"mt-[1.9em] scroll-mt-[calc(var(--header-h)+24px)] text-[length:clamp(24px,calc(0.9vw+20.6px),38px)] leading-[1.15] font-medium tracking-[-0.02em] text-ink text-balance first:mt-0","children":["How we help"]}]
