29:["$","h2","b4",{"id":"choose-tasks-with-clear-rules","className":"mt-[1.9em] scroll-mt-[calc(var(--header-h)+24px)] text-[length:clamp(24px,calc(0.9vw+20.6px),38px)] leading-[1.15] font-medium tracking-[-0.02em] text-ink text-balance first:mt-0","children":["Choose tasks with clear rules"]}]
2a:["$","p","b5",{"className":"mt-[1.1em] first:mt-0","children":["A good first task has a clear start, a clear finish and a way to check the result. “Put each invoice’s supplier, date and total into the accounts” is a good candidate. “Decide which suppliers to keep” is not: that needs judgement and context only your people have."]}]
2b:["$","h2","b6",{"id":"what-ai-adds","className":"mt-[1.9em] scroll-mt-[calc(var(--header-h)+24px)] text-[length:clamp(24px,calc(0.9vw+20.6px),38px)] leading-[1.15] font-medium tracking-[-0.02em] text-ink text-balance first:mt-0","children":["What AI adds"]}]
2c:["$","p","b7",{"className":"mt-[1.1em] first:mt-0","children":["Older automation could only follow fixed rules on tidy data. AI can also read and write. It can pull details out of a scanned document, tell a complaint from a sales enquiry, draft a reply or summarise a long thread. That opens up work that used to need a person for every single item."]}]
2d:["$","h2","b8",{"id":"keep-a-person-in-the-loop","className":"mt-[1.9em] scroll-mt-[calc(var(--header-h)+24px)] text-[length:clamp(24px,calc(0.9vw+20.6px),38px)] leading-[1.15] font-medium tracking-[-0.02em] text-ink text-balance first:mt-0","children":["Keep a person in the loop"]}]
2e:["$","p","b9",{"className":"mt-[1.1em] first:mt-0","children":["Start with automation preparing the work and a person approving it:"]}]
2f:["$","ol","b10l0-parent",{"className":"mt-[1.1em] list-decimal space-y-[0.5em] pl-[1.4em] marker:font-medium marker:text-accent","children":[["$","li","b10l0",{"children":["Let automation prepare the work: the details pulled out, the draft reply, the report"]}],["$","li","b10l1",{"children":["Let a person check and approve it"]}],["$","li","b10l2",{"children":["Automate the approval only once the results are reliably right"]}]]}]
30:["$","p","b11",{"className":"mt-[1.1em] first:mt-0","children":["This builds trust, catches mistakes early and shows exactly where the automation needs to improve."]}]
31:["$","h2","b12",{"id":"work-inside-the-tools-you-already-use","className":"mt-[1.9em] scroll-mt-[calc(var(--header-h)+24px)] text-[length:clamp(24px,calc(0.9vw+20.6px),38px)] leading-[1.15] font-medium tracking-[-0.02em] text-ink text-balance first:mt-0","children":["Work inside the tools you already use"]}]
32:["$","p","b13",{"className":"mt-[1.1em] first:mt-0","children":["Automation works best inside the systems people already open every day: email, the accounts software, customer records, a shared spreadsheet. Nobody should have to learn a new screen to benefit from it."]}]
33:["$","h2","b14",{"id":"look-after-data-and-access","className":"mt-[1.9em] scroll-mt-[calc(var(--header-h)+24px)] text-[length:clamp(24px,calc(0.9vw+20.6px),38px)] leading-[1.15] font-medium tracking-[-0.02em] text-ink text-balance first:mt-0","children":["Look after data and access"]}]
34:["$","p","b15",{"className":"mt-[1.1em] first:mt-0","children":["Decide what the automation can see and what it can change. Keep sensitive information where it already lives, give each automation only the access it needs and keep a record of what it did."]}]
35:["$","h2","b16",{"id":"measure-the-time-saved","className":"mt-[1.9em] scroll-mt-[calc(var(--header-h)+24px)] text-[length:clamp(24px,calc(0.9vw+20.6px),38px)] leading-[1.15] font-medium tracking-[-0.02em] text-ink text-balance first:mt-0","children":["Measure the time saved"]}]
36:["$","p","b17",{"className":"mt-[1.1em] first:mt-0","children":["Note how long the task takes today and how often it happens. Check again after a few weeks. The difference shows whether it worked and which task to automate next."]}]
37:["$","h2","b18",{"id":"where-to-start","className":"mt-[1.9em] scroll-mt-[calc(var(--header-h)+24px)] text-[length:clamp(24px,calc(0.9vw+20.6px),38px)] leading-[1.15] font-medium tracking-[-0.02em] text-ink text-balance first:mt-0","children":["Where to start"]}]
38:["$","p","b19",{"className":"mt-[1.1em] first:mt-0","children":["Pick one task this month: common, rule-based and disliked. Automate it with a person checking the output, measure the result, then move to the next. See how we approach ",["$","$L12","b19s1",{"href":"/services/ai-automation","className":"link-accent text-ink underline underline-offset-[0.2em]","children":["AI automation"]}],", or ",["$","$L12","b19s3",{"href":"/contact","className":"link-accent text-ink underline underline-offset-[0.2em]","children":["tell us which task you would hand over first"]}],"."]}]
