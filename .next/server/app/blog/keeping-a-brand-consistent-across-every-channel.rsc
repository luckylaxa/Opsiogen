 posts"}],["$","svg",null,{"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":1.6,"strokeLinecap":"round","strokeLinejoin":"round","aria-hidden":"true","focusable":"false","className":"size-[1.1em]","children":["$","path",null,{"d":"M4 12h15m-6-6 6 6-6 6"}]}]]}]]}],["$","ul",null,{"className":"grid gap-x-gap gap-y-[clamp(40px,3vw,64px)] sm:grid-cols-2 lg:grid-cols-3","children":[["$","li","post-how-to-show-up-in-google-and-ai-answers",{"children":["$","article",null,{"className":"group relative flex h-full flex-col","children":[["$","div",null,{"className":"relative aspect-[16/10] overflow-hidden rounded-card border border-line bg-night","children":["$","img",null,{"alt":"Search cards on forest green: a walking boots guide in first place, a ranking chart climbing to the top and a list of search terms","loading":"lazy","fetchPriority":"low","decoding":"async","style":{"position":"absolute","height":"100%","width":"100%","left":0,"top":0,"right":0,"bottom":0,"objectFit":"$undefined","objectPosition":"$undefined","color":"transparent","backgroundImage":"url(data:image/jpeg;base64,)","backgroundSize":"100000% 100000%","backgroundPosition":"50% 50%"},"sizes":"(min-width: 1024px) 31vw, (min-width: 640px) 47vw, 100vw","srcSet":"$6a","src":"https://cdn.sanity.io/images/79m429dl/production/05ee4551e9b5eb491881b7a7e90717b48ede340e-1600x1000.jpg?w=3840&q=75&fit=max&auto=format","className":"object-cover transition-transform duration-700 ease-[var(--ease-out-soft)] group-hover:scale-[1.03]"}]}],"$L6b","$L6c","$L6d","$L6e"]}]}],"$L6f","$L70"]}]]}]}]
