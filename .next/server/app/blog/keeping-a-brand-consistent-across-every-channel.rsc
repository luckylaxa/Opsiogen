59:["$","h2","b3",{"id":"write-down-the-few-rules-that-matter","className":"mt-[1.9em] scroll-mt-[calc(var(--header-h)+24px)] text-[length:clamp(24px,calc(0.9vw+20.6px),38px)] leading-[1.15] font-medium tracking-[-0.02em] text-ink text-balance first:mt-0","children":["Write down the few rules that matter"]}]
5a:["$","p","b4",{"className":"mt-[1.1em] first:mt-0","children":["Most everyday decisions come down to a handful of things:"]}]
5b:["$","ul","b5l0-parent",{"className":"mt-[1.1em] list-disc space-y-[0.5em] pl-[1.3em] marker:text-accent","children":[["$","li","b5l0",{"children":[["$","strong","b5l0s0",{"className":"font-semibold text-ink","children":["Logo:"]}]," the versions, the space around it and what not to do with it"]}],["$","li","b5l1",{"children":[["$","strong","b5l1s0",{"className":"font-semibold text-ink","children":["Colour:"]}]," the main colours, the supporting ones and where each is used"]}],["$","li","b5l2",{"children":[["$","strong","b5l2s0",{"className":"font-semibold text-ink","children":["Type:"]}]," the fonts and how headings, text and captions relate"]}],["$","li","b5l3",{"children":[["$","strong","b5l3s0",{"className":"font-semibold text-ink","children":["Imagery:"]}]," the style of photos, illustrations and icons"]}],["$","li","b5l4",{"children":[["$","strong","b5l4s0",{"className":"font-semibold text-ink","children":["Voice:"]}]," how the brand sounds, with a few examples of what to say and what to avoid"]}]]}]
5c:["$","p","b6",{"className":"mt-[1.1em] first:mt-0","children":["Keep the guide short enough to read in one sitting. A long document nobody opens protects nothing."]}]
5d:["$","h2","b7",{"id":"give-people-templates","className":"mt-[1.9em] scroll-mt-[calc(var(--header-h)+24px)] text-[length:clamp(24px,calc(0.9vw+20.6px),38px)] leading-[1.15] font-medium tracking-[-0.02em] text-ink text-balance first:mt-0","children":["Give people templates"]}]
5e:["$","p","b8",{"className":"mt-[1.1em] first:mt-0","children":["Templates do more for consistency than any rulebook. Ready-made layouts for social posts, presentations, documents, email signatures and ads mean people start from something on brand instead of a blank page."]}]
5f:["$","h2","b9",{"id":"keep-every-file-in-one-place","className":"mt-[1.9em] scroll-mt-[calc(var(--header-h)+24px)] text-[length:clamp(24px,calc(0.9vw+20.6px),38px)] leading-[1.15] font-medium tracking-[-0.02em] text-ink text-balance first:mt-0","children":["Keep every file in one place"]}]
60:["$","p","b10",{"className":"mt-[1.1em] first:mt-0","children":["Put the current logos, fonts, templates and approved photos in one shared place, and remove the old versions. Plenty of inconsistency starts with an outdated file found in an old email."]}]
61:["$","h2","b11",{"id":"adapt-without-breaking-the-brand","className":"mt-[1.9em] scroll-mt-[calc(var(--header-h)+24px)] text-[length:clamp(24px,calc(0.9vw+20.6px),38px)] leading-[1.15] font-medium tracking-[-0.02em] text-ink text-balance first:mt-0","children":["Adapt without breaking the brand"]}]
62:["$","p","b12",{"className":"mt-[1.1em] first:mt-0","children":["Every channel has its own shapes and habits. A banner, a story and a printed brochure can’t look identical, and they shouldn’t. Keep the core fixed (logo, colours, type and voice) and let layout and format flex to suit each one."]}]
63:["$","h2","b13",{"id":"make-someone-responsible","className":"mt-[1.9em] scroll-mt-[calc(var(--header-h)+24px)] text-[length:clamp(24px,calc(0.9vw+20.6px),38px)] leading-[1.15] font-medium tracking-[-0.02em] text-ink text-balance first:mt-0","children":["Make someone responsible"]}]
64:["$","p","b14",{"className":"mt-[1.1em] first:mt-0","children":["Name one person who answers brand questions and approves new templates. It doesn’t have to be a full-time role, but it does have to be someone’s job."]}]
65:["$","h2","b15",{"id":"review-it-regularly","className":"mt-[1.9em] scroll-mt-[calc(var(--header-h)+24px)] text-[length:clamp(24px,calc(0.9vw+20.6px),38px)] leading-[1.15] font-medium tracking-[-0.02em] text-ink text-balance first:mt-0","children":["Review it regularly"]}]
66:["$","p","b16",{"className":"mt-[1.1em] first:mt-0","children":["Every few months, put recent work side by side: website, social, sales material and print. Where things drifted, ask why. Often a rule was unclear or a template was missing. Fix the system, not just the file."]}]
