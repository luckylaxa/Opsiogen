24:["$","div",null,{"className":"min-w-0 max-w-[68ch]","children":[["$","div",null,{"className":"text-[length:clamp(17px,calc(0.33vw+15.8px),21px)] leading-[1.65] text-ink-2","children":[["$","p","b0",{"className":"mt-[1.1em] first:mt-0","children":["When people look for a business like yours, they might scan a page of search results or ask an AI assistant for a recommendation. Both reward the same things: pages that are easy to find, easy to understand and easy to trust. Here is what we put in place on every site, and what you can check on yours."]}],["$","h2","b1",{"id":"how-do-search-engines-and-ai-assistants-choose-a-page","className":"mt-[1.9em] scroll-mt-[calc(var(--header-h)+24px)] text-[length:clamp(24px,calc(0.9vw+20.6px),38px)] leading-[1.15] font-medium tracking-[-0.02em] text-ink text-balance first:mt-0","children":["How do search engines and AI assistants choose a page?"]}],["$","p","b2",{"className":"mt-[1.1em] first:mt-0","children":["Both work in a similar way. They find your pages, read them, work out what each one is about and judge whether it’s trustworthy enough to show. A page that is hard to reach, vague or slow loses out at every step, however good the business behind it."]}],["$","h2","b3",{"id":"make-sure-your-pages-can-be-found","className":"mt-[1.9em] scroll-mt-[calc(var(--header-h)+24px)] text-[length:clamp(24px,calc(0.9vw+20.6px),38px)] leading-[1.15] font-medium tracking-[-0.02em] text-ink text-balance first:mt-0","children":["Make sure your pages can be found"]}],["$","p","b4",{"className":"mt-[1.1em] first:mt-0","children":["Start with the basics. Check that:"]}],["$","ul","b5l0-parent",{"className":"mt-[1.1em] list-disc space-y-[0.5em] pl-[1.3em] marker:text-accent","children":[["$","li","b5l0",{"children":["Every page has its own clear address and is linked from somewhere on the site"]}],["$","li","b5l1",{"children":["A sitemap lists every page you want found"]}],["$","li","b5l2",{"children":["Nothing important is hidden from search engines by mistake"]}],["$","li","b5l3",{"children":["The site is verified in the search engines’ webmaster tools, so you can see how they read it"]}]]}],["$","h2","b6",{"id":"answer-the-questions-your-customers-ask","className":"mt-[1.9em] scroll-mt-[calc(var(--header-h)+24px)] text-[length:clamp(24px,calc(0.9vw+20.6px),38px)] leading-[1.15] font-medium tracking-[-0.02em] text-ink text-balance first:mt-0","children":["Answer the questions your customers ask"]}],["$","p","b7",{"className":"mt-[1.1em] first:mt-0","children":["Write down the questions people ask before they buy: what it costs, how long it takes, how it works and whether it suits them. Give each important question a clear place on your site. Put the direct answer first, in a sentence or two, then the detail. Clear, self-contained answers are easier for search engines to show and for AI assistants to quote."]}],["$","h2","b8",{"id":"give-every-page-a-clear-structure","className":"mt-[1.9em] scroll-mt-[calc(var(--header-h)+24px)] text-[length:clamp(24px,calc(0.9vw+20.6px),38px)] leading-[1.15] font-medium tracking-[-0.02em] text-ink text-balance first:mt-0","children":["Give every page a clear structure"]}],["$","p","b9",{"className":"mt-[1.1em] first:mt-0","children":["Use one main heading that says what the page is about, then subheadings that describe each section, in order. Keep paragraphs short and use lists where they help. Structure helps people scan, and it helps machines understand what each part of the page covers."]}],["$","h2","b10",{"id":"add-faqs-where-questions-come-up","className":"mt-[1.9em] scroll-mt-[calc(var(--header-h)+24px)] text-[length:clamp(24px,calc(0.9vw+20.6px),38px)] leading-[1.15] font-medium tracking-[-0.02em] text-ink text-balance first:mt-0","children":["Add FAQs where questions come up"]}],"$L2e","$L2f","$L30","$L31","$L32","$L33","$L34","$L35","$L36","$L37","$L38","$L39","$L3a","$L3b","$L3c"]}],"$L3d"]}]
