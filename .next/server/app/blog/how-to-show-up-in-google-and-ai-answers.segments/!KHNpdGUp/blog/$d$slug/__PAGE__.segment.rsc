2e:["$","p","b11",{"className":"mt-[1.1em] first:mt-0","children":["A short set of questions and answers on a service page settles doubts before they become objections, and it matches the way people search and ask. Keep the answers honest and specific, and mark them up so search engines know they are questions and answers."]}]
2f:["$","h2","b12",{"id":"tell-search-engines-what-each-page-is","className":"mt-[1.9em] scroll-mt-[calc(var(--header-h)+24px)] text-[length:clamp(24px,calc(0.9vw+20.6px),38px)] leading-[1.15] font-medium tracking-[-0.02em] text-ink text-balance first:mt-0","children":["Tell search engines what each page is"]}]
30:["$","p","b13",{"className":"mt-[1.1em] first:mt-0","children":["Every page needs its own title and description, written for people: what the page offers and why it’s worth the click. Behind the scenes, structured data, a small piece of code, tells search engines what they are looking at: your organisation, a service, an article or a set of questions. It removes the guesswork."]}]
31:["$","h2","b14",{"id":"show-who-you-are","className":"mt-[1.9em] scroll-mt-[calc(var(--header-h)+24px)] text-[length:clamp(24px,calc(0.9vw+20.6px),38px)] leading-[1.15] font-medium tracking-[-0.02em] text-ink text-balance first:mt-0","children":["Show who you are"]}]
32:["$","p","b15",{"className":"mt-[1.1em] first:mt-0","children":["Search engines and AI assistants prefer sources they can trust. Make that easy: a clear About page, real contact details, examples of your work, and the same business name and description everywhere you appear. Vague, anonymous pages are hard to recommend."]}]
33:["$","h2","b16",{"id":"make-it-fast-and-easy-on-a-phone","className":"mt-[1.9em] scroll-mt-[calc(var(--header-h)+24px)] text-[length:clamp(24px,calc(0.9vw+20.6px),38px)] leading-[1.15] font-medium tracking-[-0.02em] text-ink text-balance first:mt-0","children":["Make it fast and easy on a phone"]}]
34:["$","p","b17",{"className":"mt-[1.1em] first:mt-0","children":["Slow pages lose visitors before they read a word. Compress images, keep scripts light and check every page on a phone. Speed is one of the few things you fully control."]}]
35:["$","h2","b18",{"id":"get-mentioned-elsewhere","className":"mt-[1.9em] scroll-mt-[calc(var(--header-h)+24px)] text-[length:clamp(24px,calc(0.9vw+20.6px),38px)] leading-[1.15] font-medium tracking-[-0.02em] text-ink text-balance first:mt-0","children":["Get mentioned elsewhere"]}]
36:["$","p","b19",{"className":"mt-[1.1em] first:mt-0","children":["What others say about you counts too. Listings in relevant directories, partner pages, reviews and articles that mention your business all help search engines and AI assistants understand who you are and what you’re known for. Keep your details consistent everywhere they appear."]}]
37:["$","h2","b20",{"id":"keep-it-current","className":"mt-[1.9em] scroll-mt-[calc(var(--header-h)+24px)] text-[length:clamp(24px,calc(0.9vw+20.6px),38px)] leading-[1.15] font-medium tracking-[-0.02em] text-ink text-balance first:mt-0","children":["Keep it current"]}]
38:["$","p","b21",{"className":"mt-[1.1em] first:mt-0","children":["Update pages when your services, prices or details change, and remove what’s out of date. Accurate pages are more useful to people, and more likely to be shown."]}]
39:["$","h2","b22",{"id":"how-do-you-know-it-s-working","className":"mt-[1.9em] scroll-mt-[calc(var(--header-h)+24px)] text-[length:clamp(24px,calc(0.9vw+20.6px),38px)] leading-[1.15] font-medium tracking-[-0.02em] text-ink text-balance first:mt-0","children":["How do you know it’s working?"]}]
3a:["$","p","b23",{"className":"mt-[1.1em] first:mt-0","children":["Watch how often your pages appear in search and how many visits turn into enquiries. Ask new customers how they found you. And ask AI assistants the questions your customers would ask: see whether you’re mentioned, and what they say about you."]}]
