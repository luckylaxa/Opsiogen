d:Tb1d,{"@context":"https://schema.org","@graph":[{"@type":"Service","name":"AI Websites & Revamps","description":"Modern websites, live in a week. We design and build fast, conversion-focused websites with an easy-to-use CMS, so you can update content without waiting on developers. Built with AI and finished by designers, your site goes from brief to launch in days, not months.","url":"https://opsiogen.com/services/ai-websites","provider":{"@id":"https://opsiogen.com/#organization"}},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://opsiogen.com/"},{"@type":"ListItem","position":2,"name":"Services","item":"https://opsiogen.com/services"},{"@type":"ListItem","position":3,"name":"AI Websites & Revamps","item":"https://opsiogen.com/services/ai-websites"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Will an AI-built site look like everyone else's?","acceptedAnswer":{"@type":"Answer","text":"No. AI speeds up the build. Our designers shape every page around your brand and your customers."}},{"@type":"Question","name":"Will people find it on Google and in AI search?","acceptedAnswer":{"@type":"Answer","text":"We build every page with clear headings, fast loading and proper page details, so search engines and AI assistants can read it."}},{"@type":"Question","name":"How fast can my website go live?","acceptedAnswer":{"@type":"Answer","text":"Basic websites go live in 7 days. Larger sites take longer, and we agree the timeline with you before we start."}},{"@type":"Question","name":"Can I update the site myself?","acceptedAnswer":{"@type":"Answer","text":"Yes. Every site comes with an easy-to-use CMS, so you can edit text, pages and images without a developer."}},{"@type":"Question","name":"Can you revamp my current site?","acceptedAnswer":{"@type":"Answer","text":"Yes. We redesign and rebuild outdated sites and keep the content that still works."}},{"@type":"Question","name":"How is the work priced?","acceptedAnswer":{"@type":"Answer","text":"With a fixed price agreed before we start, or a monthly plan. Start on a monthly plan or bring us a project."}},{"@type":"Question","name":"Who owns the work?","acceptedAnswer":{"@type":"Answer","text":"You do. You own everything we build."}},{"@type":"Question","name":"Will my site work on phones?","acceptedAnswer":{"@type":"Answer","text":"Yes. Every site is designed and tested for phones, tablets and desktops."}},{"@type":"Question","name":"Can you write the copy?","acceptedAnswer":{"@type":"Answer","text":"Yes. We write clear, conversion-focused copy, or polish the copy you have."}},{"@type":"Question","name":"What do you need from us to start?","acceptedAnswer":{"@type":"Answer","text":"Your goals, any content you already have and access to your domain. We guide you through the rest."}}]}]}c:[["children",{"s":"__PAGE__","h":160,"d":{"r":["$","$3","c",{"children":[[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$d"}}],[["$","section",null,{"data-band":true,"className":"-mt-[var(--header-h)] bg-page pb-[clamp(40px,calc(2.3vw+31.4px),76px)] pt-[calc(var(--header-h)+clamp(40px,calc(1.57vw+34px),64px))]","children":["$Le","$Lf"]}],"$L10","$L11","$L12","$L13"]],["$L14","$L15"],"$L16"]}],"p":"$@17","v":null,"s":"$9"}}]]
