d:T967,{"@context":"https://schema.org","@graph":[{"@type":"Service","name":"AI MVPs & Business Apps","description":"From idea to working product in weeks. We use AI to turn ideas into working software fast: MVPs to test with users and investors, portals for your customers, and internal tools that replace spreadsheets and manual work.","url":"https://opsiogen.com/services/ai-mvps-business-apps","provider":{"@id":"https://opsiogen.com/#organization"}},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://opsiogen.com/"},{"@type":"ListItem","position":2,"name":"Services","item":"https://opsiogen.com/services"},{"@type":"ListItem","position":3,"name":"AI MVPs & Business Apps","item":"https://opsiogen.com/services/ai-mvps-business-apps"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How do you keep AI features reliable?","acceptedAnswer":{"@type":"Answer","text":"A person stays in charge of the steps that matter, like confirming an order, and we test AI features with real examples before launch."}},{"@type":"Question","name":"How fast can you build an MVP?","acceptedAnswer":{"@type":"Answer","text":"We take you from idea to working product in weeks, and agree the scope and timeline before we start."}},{"@type":"Question","name":"Can the MVP grow into a full product?","acceptedAnswer":{"@type":"Answer","text":"Yes. We build the first version so it can grow with your users and your business."}},{"@type":"Question","name":"Do we need our own developers?","acceptedAnswer":{"@type":"Answer","text":"No. We design, build and launch, then support the product after launch."}},{"@type":"Question","name":"Who owns the work?","acceptedAnswer":{"@type":"Answer","text":"You do. You own everything we build."}},{"@type":"Question","name":"What can you build?","acceptedAnswer":{"@type":"Answer","text":"MVPs, customer portals, dashboards, booking systems, internal tools, and AI features inside your product."}},{"@type":"Question","name":"Can you add AI to software we already have?","acceptedAnswer":{"@type":"Answer","text":"Yes. We add features such as smart search, chat and summaries to products you already use."}},{"@type":"Question","name":"How is the work priced?","acceptedAnswer":{"@type":"Answer","text":"With a fixed price agreed before we start, or a monthly plan. Start on a monthly plan or bring us a project."}}]}]}c:[["children",{"s":"__PAGE__","h":160,"d":{"r":["$","$3","c",{"children":[[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$d"}}],[["$","section",null,{"data-band":true,"className":"-mt-[var(--header-h)] bg-page pb-[clamp(40px,calc(2.3vw+31.4px),76px)] pt-[calc(var(--header-h)+clamp(40px,calc(1.57vw+34px),64px))]","children":[["$","div",null,{"className":"relative isolate","children":[["$","$L12",null,{"short":true}],["$","div",null,{"className":"@container flex flex-col items-center px-gutter text-center","children":[["$","p",null,{"className":"mb-[clamp(24px,calc(2.03vw+16.4px),55px)] rounded-[4px] border border-ink/25 px-[0.6em] py-[0.15em] text-base text-ink","children":"Build"}],["$","h1",null,{"className":"text-giant-m giant-wrap w-full font-bold uppercase","style":{"fontSize":"min(var(--text-giant-m), calc(100cqw / 4.553))"},"children":"$L13"}],"$L14",["$L15",""]]}]]}],"$L16"]}],"$L17","$L18","$L19","$L1a"]],["$L1b","$L1c"],"$L1d"]}],"p":"$@1e","v":null,"s":"$9"}}]]
