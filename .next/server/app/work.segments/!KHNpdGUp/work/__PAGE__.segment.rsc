rsecom: AI Brand Services","height":1200,"hotspot":null,"lqip":"data:image/jpeg;base64,","url":"https://cdn.sanity.io/images/79m429dl/production/fb466e1a361419b12ee92bc63cb8c0b13f07d1a2-1600x1200.jpg","width":1600},"coverVideo":null,"industry":null,"name":"Norsecom","order":10,"services":[{"group":"create","name":"AI Brand Services","shortName":"Brand","slug":"ai-brand-services"}],"slug":"norsecom","summary":"Brand work for Norsecom.","year":null},{"_id":"project-rxlive","cardImage":{"alt":"The RxLive worklist on a laptop, on a sage backdrop","height":1200,"hotspot":null,"lqip":"data:image/jpeg;base64,","url":"https://cdn.sanity.io/images/79m429dl/production/823dfd05c85368d35fed6e79909f756ffbdc0d55-1512x1200.jpg","width":1512},"client":"Rxlive","cover":{"alt":"Rxlive: AI Product Design & Design Systems","height":1200,"hotspot":null,"lqip":"data:image/jpeg;base64,","url":"https://cdn.sanity.io/images/79m429dl/production/4d67f2c6d61ecec3c8703b0cdd8d095892d82fdb-1600x1200.jpg","width":1600},"coverVideo":null,"industry":"Healthcare","name":"Rxlive","order":11,"services":[{"group":"build","name":"AI Product Design & Design Systems","shortName":"Product Design","slug":"ai-product-design"}],"slug":"rxlive","summary":"Rxlive brings scattered medical, pharmacy and patient data into one platform. We designed a clear web app that helps care teams spot trends and make informed decisions.","year":"2022"},{"_id":"project-afthab-tours","cardImage":{"alt":"Afthab Tours Instagram posts and a Meta ad for Georgia, on an Afthab blue backdrop","height":1200,"hotspot":null,"lqip":"data:image/jpeg;base64,","url":"https://cdn.sanity.io/images/79m429dl/production/7b36f125bc94ad2a9479922172bc3837af2e8a0b-1600x1200.jpg","width":1600},"client":"Afthab Tours","cover":{"alt":"Afthab Tours: AI Social Media Marketing","height":1200,"hotspot":null,"lqip":"data:image/jpeg;base64,","url":"https://cdn.sanity.io/images/79m429dl/production/6604b1d81c02a4969b0f8bfca8dd753c0873fcae-1600x1200.jpg","width":