a:[["children",{"s":"__PAGE__","h":160,"d":{"r":["$","$3","c",{"children":[[["$","$Lf",null,{"projects":[{"_id":"project-surgo-health","cardImage":{"alt":"Hands holding the Surgo Health index on a tablet, on a tomato red backdrop","height":1200,"hotspot":null,"lqip":"data:image/jpeg;base64,","url":"https://cdn.sanity.io/images/79m429dl/production/cd28455b4134015e1f59961afb749e31cf67c219-1512x1200.jpg","width":1512},"client":"Surgo Health","cover":{"alt":"Surgo Health: AI Product Design & Design Systems, AI Websites & Revamps","height":1200,"hotspot":null,"lqip":"data:image/jpeg;base64,","url":"https://cdn.sanity.io/images/79m429dl/production/aee543760719170da352c1b1e61b0ec36048037c-1600x1200.jpg","width":1600},"coverVideo":null,"industry":"Healthcare","name":"Surgo Health","order":1,"services":[{"group":"build","name":"AI Product Design & Design Systems","shortName":"Product Design","slug":"ai-product-design"},{"group":"build","name":"AI Websites & Revamps","shortName":"Websites","slug":"ai-websites"}],"slug":"surgo-health","summary":"Surgo Health grew from a consultancy into a SaaS product that helps healthcare teams decide with data. We designed its insight dashboards, a survey app and its website.","year":"2022"},{"_id":"project-oh-my-glam","cardImage":{"alt":"A hand holding the Oh My Glam lipstick page on a phone, on a blush pink backdrop","height":1200,"hotspot":null,"lqip":"data:image/jpeg;base64,","url":"https://cdn.sanity.io/images/79m429dl/production/f834b99b50fb626b6e427406f8d2e9345a601fdd-1512x1200.jpg","width":1512},"client":"Oh My Glam","cover":{"alt":"Oh My Glam: AI Product Design & Design Systems","height":1200,"hotspot":null,"lqip":"data:image/jpeg;base64,","url":"https://cdn.sanity.io/images/79m429dl/production/e8c1b9415dba82f6dddbf702daf552b3ffc176e5-1600x1200.jpg","width":1600},"coverVideo":null,"industry":"Beauty","name":"Oh My Glam","order":2,"services":[{"group":"build","name":"AI Product Design & Design Systems","shortName":"Product Design","slug":"ai-product-design"}],"slug":"oh-my-glam","summary":"Oh My Glam lets shoppers try make-up on live before they buy. We designed the mobile app: AR try-on for lips, eyes and face, AI shade matching from a face scan, Glam AI for looks and artist bookings, and checkout.","year":"2017"},{"_id":"project-bigtapp","cardImage":{"alt":"The BigTapp homepage on a laptop, on a cobalt blue backdrop","height":1200,"hotspot":null,"lqip":"data:image/jpeg;base64,","url":"https://cdn.sanity.io/images/79m429dl/production/36c609ebc31977179431d7f98712aee2aafd6427-1512x1200.jpg","width":1512},"client":"BigTapp","cover":{"alt":"BigTapp: AI Websites & Revamps, Digital Marketing, AI Print & Collateral Design","height":1200,"hotspot":null,"lqip":"data:image/jpeg;base64,","url":"https://cdn.sanity.io/images/79m429dl/production/cd3de786b0c75e56bda9bea5db9fae9c580897b3-1600x1200.jpg","width":1600},"coverVideo":null,"industry":"Data, AI and automation","name":"BigTapp","order":3,"services":[{"group":"build","name":"AI Websites & Revamps","shortName":"Websites","slug":"ai-websites"},{"group":"grow","name":"Digital Marketing","shortName":"Digital Marketing","slug":"digital-marketing"},{"group":"create","name":"AI Print & Collateral Design","shortName":"Print","slug":"ai-print-collateral"}],"slug":"bigtapp","summary":"Website, digital marketing and print for BigTapp, an enterprise data, AI and automation company.","year":null},{"_id":"project-care-connect","cardImage":{"alt":"Hands holding a tablet with a Care Connect patient review: the patient, a fit score of 92 and a readmission risk gauge","height":1200,"hotspot":null,"lqip":"data:image/jpeg;base64,","url":"https://cdn.sanity.io/images/79m429dl/production/6c5f044fb11abb68c7bc75c39c78b5cf20b67581-1512x1200.jpg","width":1512},"client":"Care Connect","cover":{"alt":"Care Connect: AI Product Design & Design Systems, AI MVPs & Business Apps","height":1200,"hotspot":null,"lqip":"data:image/jpeg;base64,","url":"https://cdn.sanity.io/images/79m429dl/production/e84df8c426fd0025ac87bf25149975786ebde0a9-1600x1200.jpg","width":1600},"coverVideo":null,"industry":"Healthcare","name":"Care Connect","order":4,"services":[{"group":"build","name":"AI Product Design & Design Systems","shortName":"Product Design","slug":"ai-product-design"},{"group":"build","name":"AI MVPs & Business Apps","shortName":"MVPs & Apps","slug":"ai-mvps-business-apps"}],"slug":"care-connect","summary":"Care Connect manages referrals in post-acute care. We designed one web and mobile platform where providers, administrators and staff share real-time data, insights and secure messages.","year":"2021"},{"_id":"project-sandlogic","cardImage":{"alt":"A SandLogic water bottle and mug, on a lilac backdrop","height":1200,"hotspot":null,"lqip":"data:image/jpeg;base64,","url":"https://cdn.sanity.io/images/79m429dl/production/a823546ff8d1c72476bb124da97c7ca3ee49a59b-1512x1200.jpg","width":1512},"client":"SandLogic","cover":{"alt":"SandLogic: AI Brand Services","height":1200,"hotspot":null,"lqip":"data:image/jpeg;base64,","url":"https://cdn.sanity.io/images/79m429dl/production/71ffedbae5f9c2bcea94b08bf92b194389e0b82b-1600x1200.jpg","width":1600},"coverVideo":null,"industry":"Artificial intelligence","name":"SandLogic","order":5,"services":[{"group":"create","name":"AI Brand Services","shortName":"Brand","slug":"ai-brand-services"}],"slug":"sandlogic","summary":"Brand work for SandLogic, an enterprise and edge AI company.","year":null},{"_id":"project-engel-volkers","cardImage":{"alt":"The Engel & Völkers homepage on a tablet resting on travertine, on a sand backdrop","height":1200,"hotspot":null,"lqip":"data:image/jpeg;base64,","url":"https://cdn.sanity.io/images/79m429dl/production/e7303128b8ec6d6e1a58cf211491dc69b2f8dcf7-1512x1200.jpg","width":1512},"client":"Engel & Völkers","cover":{"alt":"Engel & Völkers: AI Websites & Revamps","height":1200,"hotspot":null,"lqip":"data:image/jpeg;base64,","url":"https://cdn.sanity.io/images/79m429dl/production/492aaa