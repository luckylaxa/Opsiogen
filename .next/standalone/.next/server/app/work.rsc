d:[["$","$L52",null,{"projects":[{"_id":"project-surgo-health","cardImage":{"alt":"Hands holding the Surgo Health index on a tablet, on a tomato red backdrop","height":1200,"hotspot":null,"lqip":"data:image/jpeg;base64,","url":"https://cdn.sanity.io/images/79m429dl/production/cd28455b4134015e1f59961afb749e31cf67c219-1512x1200.jpg","width":1512},"client":"Surgo Health","cover":{"alt":"Surgo Health: AI Product Design & Design Systems, AI Websites & Revamps","height":1200,"hotspot":null,"lqip":"data:image/jpeg;base64,","url":"https://cdn.sanity.io/images/79m429dl/production/aee543760719170da352c1b1e61b0ec36048037c-1600x1200.jpg","width":1600},"coverVideo":null,"industry":"Healthcare","name":"Surgo Health","order":1,"services":[{"group":"build","name":"AI Product Design & Design Systems","shortName":"Product Design","slug":"ai-product-design"},{"group":"build","name":"AI Websites & Revamps","shortName":"Websites","slug":"ai-websites"}],"slug":"surgo-health","summary":"Surgo Health grew from a consultancy into a SaaS product that helps healthcare teams decide with data. We designed its insight dashboards, a survey app and its website.","year":"2022"},{"_id":"project-oh-my-glam","cardImage":{"alt":"A hand holding the Oh My Glam lipstick page on a phone, on a blush pink backdrop","height":1200,"hotspot":null,"lqip":"data:image/jpeg;base64,","url":"https://cdn.sanity.io/images/79m429dl/production/f834b99b50fb626b6e427406f8d2e9345a601fdd-1512x1200.jpg","width":1512},"client":"Oh My Glam","cover":{"alt":"Oh My Glam: AI Product Design & Design Systems","height":1200,"hotspot":null,"lqip":"data:image/jpeg;base64,","url":"https://cdn.sanity.io/images/79m429dl/production/e8c1b9415dba82f6dddbf702daf552b3ffc176e5-1600x1200.jpg","width":1600},"coverVideo":null,"industry":"Beauty","name":"Oh My Glam","order":2,"services":[{"group":"build","name":"AI Product Design & Design Systems","shortName":"Product Design","slug":"ai-product-design"}],"slug":"oh-my-glam","summary":"Oh My Glam lets shoppers try make-up on live before they buy. We designed the mobile app: AR try-on for lips, eyes and face, AI shade matching from a face scan, Glam AI for looks and artist bookings, and checkout.","year":"2017"},{"_id":"project-bigtapp","cardImage":{"alt":"The BigTapp homepage on a laptop, on a cobalt blue backdrop","height":1200,"hotspot":null,"lqip":"data:image/jpeg;base64,","url":"https://cdn.sanity.io/images/79m429dl/production/36c609ebc31977179431d7f98712aee2aafd6427-1512x1200.jpg","width":1512},"client":"BigTapp","cover":{"alt":"BigTapp: AI Websites & Revamps, Digital Marketing, AI Print & Collateral Design","height":1200,"hotspot":null,"lqip":"data:image/jpeg;base64,","url":"https://cdn.sanity.io/images/79m429dl/production/cd3de786b0c75e56bda9bea5db9fae9c580897b3-1600x1200.jpg","width":1600},"coverVideo":null,"industry":"Data, AI and automation","name":"BigTapp","order":3,"services":[{"group":"build","name":"AI Websites & Revamps","shortName":"Websites","slug":"ai-websites"},{"group":"grow","name":"Digital Marketing","shortName":"Digital Marketing","slug":"digital-marketing"},{"group":"create","name":"AI Print & Collateral Design","shortName":"Print","slug":"ai-print-collateral"}],"slug":"bigtapp","summary":"Website, digital marketing and print for BigTapp, an enterprise data, AI and automation company.","year":null},{"_id":"project-care-connect","cardImage":{"alt":"Hands holding a tablet with a Care Connect patient review: the patient, a fit score of 92 and a readmission risk gauge","height":1200,"hotspot":null,"lqip":"data:image/jpeg;base64,","url":"https://cdn.sanity.io/images/79m429dl/production/6c5f044fb11abb68c7bc75c39c78b5cf20b67581-1512x1200.jpg","width":1512},"client":"Care Connect","cover":{"alt":"Care Connect: AI Product Design & Design Systems, AI MVPs & Business Apps","height":1200,"hotspot":null,"lqip":"data:image/jpeg;base64,","url":"https://cdn.sanity.io/images/79m429dl/production/e84df8c426fd0025ac87bf25149975786ebde0a9-1600x1200.jpg","width":1600},"coverVideo":null,"industry":"Healthcare","name":"Care Connect","order":4,"services":[{"group":"build","name":"AI Product Design & Design Systems","shortName":"Product Design","slug":"ai-product-design"},{"group":"build","name":"AI MVPs & Business Apps","shortName":"MVPs & Apps","slug":"ai-mvps-business-apps"}],"slug":"care-connect","summary":"Care Connect manages referrals in post-acute care. We designed one web and mobile platform where providers, administrators and staff share real-time data, insights and secure messages.","year":"2021"},{"_id":"project-sandlogic","cardImage":{"alt":"A SandLogic water bottle and mug, on a lilac backdrop","height":1200,"hotspot":null,"lqip":"data:image/jpeg;base64,","url":"https://cdn.sanity.io/images/79m429dl/production/a823546ff8d1c72476bb124da97c7ca3ee49a59b-1512x1200.jpg","width":1512},"client":"SandLogic","cover":{"alt":"SandLogic: AI Brand Services","height":1200,"hotspot":null,"lqip":"data:image/jpeg;base64,","url":"https://cdn.sanity.io/images/79m429dl/production/71ffedbae5f9c2bcea94b08bf92b194389e0b82b-1600x1200.jpg","width":1600},"coverVideo":null,"industry":"Artificial intelligence","name":"SandLogic","order":5,"services":[{"group":"create","name":"AI Brand Services","shortName":"Brand","slug":"ai-brand-services"}],"slug":"sandlogic","summary":"Brand work for SandLogic, an enterprise and edge AI company.","year":null},{"_id":"project-engel-volkers","cardImage":{"alt":"The Engel & Völkers homepage on a tablet resting on travertine, on a sand backdrop","height":1200,"hotspot":null,"lqip":"data:image/jpeg;base64,","url":"https://cdn.sanity.io/images/79m429dl/production/e7303128b8ec6d6e1a58cf211491dc69b2f8dcf7-1512x1200.jpg","width":1512},"client":"Engel & Völkers","cover":{"alt":"Engel & Völkers: AI Websites & Revamps","height":1200,"hotspot":null,"lqip":"data:image/jpeg;base64,","url":"https://cdn.sanity.io/images/79m429dl/production/492aaa488160328f7bcaf645c618517cc264a301-1600x1200.jpg","width":1600},"coverVideo":null,"industry":"Real estate","name":"Engel & Völkers","order":7,"services":[{"group":"build","name":"AI Websites & Revamps","shortName":"Websites","slug":"ai-websites"}],"slug":"engel-volkers","summary":"In luxury real estate, a strong identity builds trust with high-value buyers. We created a refined branding and illustration system for Engel & Völkers, used across its website and marketing.","year":"2024"},{"_id":"project-sifio-health","cardImage":{"alt":"The Sifio Health app on a phone standing on a stone block, on a sage backdrop","height":1200,"hotspot":null,"lqip":"data:image/jpeg;base64,","url":"https://cdn.sanity.io/images/79m429dl/production/18e67accb46d42e52aa7b167c0c68562a5f0a9d0-1512x1200.jpg","width":1512},"client":"Sifio Health","cover":{"alt":"Sifio Health: AI Product Design & Design Systems, AI Websites & Revamps","height":1200,"hotspot":null,"lqip":"data:image/jpeg;base64,","url":"https://cdn.sanity.io/images/79m429dl/production/59b08b9cabfbc045df446d6808c1c323948a839f-1600x1200.jpg","width":1600},"coverVideo":null,"industry":"Healthcare software","name":"Sifio Health","order":9,"services":[{"group":"build","name":"AI Product Design & Design Systems","shortName":"Product Design","slug":"ai-product-design"},{"group":"build","name":"AI Websites & Revamps","shortName":"Websites","slug":"ai-websites"}],"slug":"sifio-health","summary":"Sifio Health builds AI software for surgical centres. We designed its perioperative web app, which turns hospital data into a live model of the surgical day, and its website.","year":null},{"_id":"project-norsecom","cardImage":{"alt":"The Norsecom exhibition booth, with the logo on a blue fascia and visitors at the counter","height":1200,"hotspot":null,"lqip":"data:image/jpeg;base64,","url":"https://cdn.sanity.io/images/79m429dl/production/01ad0121450e4048510b293eac74ff187f7f6459-1512x1200.jpg","width":1512},"client":"Norsecom","cover":{"alt":"Norsecom: AI Brand Services","height":1200,"hotspot":null,"lqip":"data:image/jpeg;base64,","url":"https://cdn.sanity.io/images/79m429dl/production/fb466e1a361419b12ee92bc63cb8c0b13f07d1a2-1600x1200.jpg","width":1600},"coverVideo":null,"industry":null,"name":"Norsecom","order":10,"services":[{"group":"create","name":"AI Brand Services","shortName":"Brand","slug":"ai-brand-services"}],"slug":"norsecom","summary":"Brand work for Norsecom.","year":null},{"_id":"project-rxlive","cardImage":{"alt":"The RxLive worklist on a laptop, on a sage backdrop","height":1200,"hotspot":null,"lqip":"data:image/jpeg;base64,","url":"https://cdn.sanity.io/images/79m429dl/production/823dfd05c85368d35fed6e79909f756ffbdc0d55-1512x1200.jpg","width":1512},"client":"Rxlive","cover":{"alt":"Rxlive: AI Product Design & Design Systems","height":1200,"hotspot":null,"lqip":"data:image/jpeg;base64,","url":"https://cdn.sanity.io/images/79m429dl/production/4d67f2c6d61ecec3c8703b0cdd8d095892d82fdb-1600x1200.jpg","width":1600},"coverVideo":null,"industry":"Healthcare","name":"Rxlive","order":11,"services":[{"group":"build","name":"AI Product Design & Design Systems","shortName":"Product Design","slug":"ai-product-design"}],"slug":"rxlive","summary":"Rxlive brings scattered medical, pharmacy and patient data into one platform. We designed a clear web app that helps care teams spot trends and make informed decisions.","year":"2022"},{"_id":"project-afthab-tours","cardImage":{"alt":"Afthab Tours Instagram posts and a Meta ad for Georgia, on an Afthab blue backdrop","height":1200,"hotspot":null,"lqip":"data:image/jpeg;base64,","url":"https://cdn.sanity.io/images/79m429dl/production/7b36f125bc94ad2a9479922172bc3837af2e8a0b-1600x1200.jpg","width":1600},"client":"Afthab Tours","cover":{"alt":"Afthab Tours: AI Social Media Marketing","height":1200,"hotspot":null,"lqip":"data:image/jpeg;base64,","url":"https://cdn.sanity.io/images/79m429dl/production/6604b1d81c02a4969b0f8bfca8dd753c0873fcae-1600x1200.jpg","width":1600},"coverVideo":null,"industry":"Travel","name":"Afthab Tours","order