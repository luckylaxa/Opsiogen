d:Ta24,{"@context":"https://schema.org","@graph":[{"@type":"Service","name":"Digital Marketing","description":"Campaigns built for leads and sales. We plan and run paid social, search ads, SEO and email aimed at what matters: enquiries, leads and return on ad spend. Every campaign is tracked from the first click to the enquiry.","url":"https://opsiogen.com/services/digital-marketing","provider":{"@id":"https://opsiogen.com/#organization"}},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://opsiogen.com/"},{"@type":"ListItem","position":2,"name":"Services","item":"https://opsiogen.com/services"},{"@type":"ListItem","position":3,"name":"Digital Marketing","item":"https://opsiogen.com/services/digital-marketing"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Does SEO still matter now that people search with AI?","acceptedAnswer":{"@type":"Answer","text":"Yes. Clear, useful pages with good structure help you show up in search results and in AI answers."}},{"@type":"Question","name":"What do you measure?","acceptedAnswer":{"@type":"Answer","text":"What matters to your business: enquiries, leads and return on ad spend."}},{"@type":"Question","name":"Can you take over our current campaigns?","acceptedAnswer":{"@type":"Answer","text":"Yes. We review what’s running, keep what works and fix what doesn’t."}},{"@type":"Question","name":"How is the work priced?","acceptedAnswer":{"@type":"Answer","text":"With a fixed price agreed before we start, or a monthly plan. Start on a monthly plan or bring us a project."}},{"@type":"Question","name":"Do you run the campaigns for us?","acceptedAnswer":{"@type":"Answer","text":"Yes. We plan, launch and manage your campaigns, and keep improving them."}},{"@type":"Question","name":"How soon will we see results?","acceptedAnswer":{"@type":"Answer","text":"Paid campaigns bring traffic as soon as they go live. SEO builds over months. We agree goals and reporting before we start."}},{"@type":"Question","name":"Do you write the ads and build the landing pages?","acceptedAnswer":{"@type":"Answer","text":"Yes. We write and design the ads, and build landing pages made to turn clicks into enquiries."}},{"@type":"Question","name":"Which channels do you use?","acceptedAnswer":{"@type":"Answer","text":"The search and social channels where your customers are, chosen with you for your goals and budget."}},{"@type":"Question","name":"Who owns the ad accounts and data?","acceptedAnswer":{"@type":"Answer","text":"You do. Your accounts, analytics and data stay yours."}}]}]}c:[["children",{"s":"__PAGE__","h":160,"d":{"r":["$","$3","c",{"children":[[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$d"}}],[["$","section",null,{"data-band":true,"className":"-mt-[var(--header-h)] bg-page pb-[clamp(40px,calc(2.3vw+31.4px),76px)] pt-[calc(var(--header-h)+clamp(40px,calc(1.57vw+34px),64px))]","children":[["$","div",null,{"className":"relative isolate","children":[["$","$L12",null,{"short":true}],["$","div",null,{"className":"@container flex flex-col items-center px-gutter text-center","children":["$L13","$L14","$L15",["$L16",""]]}]]}],"$L17"]}],"$L18","$L19","$L1a","$L1b"]],["$L1c","$L1d"],"$L1e"]}],"p":"$@1f","v":null,"s":"$9"}}]]
