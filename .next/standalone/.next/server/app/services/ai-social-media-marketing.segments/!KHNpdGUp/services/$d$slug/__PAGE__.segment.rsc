d:Ta21,{"@context":"https://schema.org","@graph":[{"@type":"Service","name":"AI Social Media Marketing","description":"Scroll-stopping content, made fast and on brand. We plan, create and publish your social content every month: posts, reels, AI video and captions in your brand voice. You get consistent output, faster turnaround and a clear monthly report.","url":"https://opsiogen.com/services/ai-social-media-marketing","provider":{"@id":"https://opsiogen.com/#organization"}},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://opsiogen.com/"},{"@type":"ListItem","position":2,"name":"Services","item":"https://opsiogen.com/services"},{"@type":"ListItem","position":3,"name":"AI Social Media Marketing","item":"https://opsiogen.com/services/ai-social-media-marketing"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Will AI-made content feel generic?","acceptedAnswer":{"@type":"Answer","text":"No. AI speeds up drafts and variations. Our designers and writers shape every post to your voice, and you approve it first."}},{"@type":"Question","name":"How much content do we get?","acceptedAnswer":{"@type":"Answer","text":"It depends on your plan. We agree the monthly output with you before we start."}},{"@type":"Question","name":"Will it sound like us?","acceptedAnswer":{"@type":"Answer","text":"Yes. We work from your brand voice and guidelines, and you approve the calendar before anything goes live."}},{"@type":"Question","name":"Do you publish for us?","acceptedAnswer":{"@type":"Answer","text":"Yes. We schedule and publish your content, then report on performance every month."}},{"@type":"Question","name":"Do you make paid social ads?","acceptedAnswer":{"@type":"Answer","text":"Yes. We design ads and variations for testing. Our Digital Marketing service can run the campaigns too."}},{"@type":"Question","name":"Which channels do you cover?","acceptedAnswer":{"@type":"Answer","text":"All the main social channels. Every post is sized and written for the channel it runs on."}},{"@type":"Question","name":"Can you make video without a shoot?","acceptedAnswer":{"@type":"Answer","text":"Yes. Many reels are made with motion graphics and AI, with no filming needed."}},{"@type":"Question","name":"How is the work priced?","acceptedAnswer":{"@type":"Answer","text":"With a fixed price agreed before we start, or a monthly plan. Start on a monthly plan or bring us a project."}},{"@type":"Question","name":"Who owns the work?","acceptedAnswer":{"@type":"Answer","text":"You do. You own everything we build."}}]}]}c:[["children",{"s":"__PAGE__","h":160,"d":{"r":["$","$3","c",{"children":[[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$d"}}],[["$","section",null,{"data-band":true,"className":"-mt-[var(--header-h)] bg-page pb-[clamp(40px,calc(2.3vw+31.4px),76px)] pt-[calc(var(--header-h)+clamp(40px,calc(1.57vw+34px),64px))]","children":[["$","div",null,{"className":"relative isolate","children":[["$","$L12",null,{"short":true}],["$","div",null,{"className":"@container flex flex-col items-center px-gutter text-center","children":["$L13","$L14","$L15",["$L16",""]]}]]}],"$L17"]}],"$L18","$L19","$L1a","$L1b"]],["$L1c","$L1d"],"$L1e"]}],"p":"$@1f","v":null,"s":"$9"}}]]
