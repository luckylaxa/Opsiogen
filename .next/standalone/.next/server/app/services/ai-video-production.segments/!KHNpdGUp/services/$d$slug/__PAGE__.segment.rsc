d:T8c9,{"@context":"https://schema.org","@graph":[{"@type":"Service","name":"AI Video Production","description":"Video that explains, sells and gets shared. We plan, script and produce video for products, ads and social. AI speeds up scripts, visuals and edits, and our designers make sure every frame is on brand.","url":"https://opsiogen.com/services/ai-video-production","provider":{"@id":"https://opsiogen.com/#organization"}},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://opsiogen.com/"},{"@type":"ListItem","position":2,"name":"Services","item":"https://opsiogen.com/services"},{"@type":"ListItem","position":3,"name":"AI Video Production","item":"https://opsiogen.com/services/ai-video-production"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Will AI video look fake?","acceptedAnswer":{"@type":"Answer","text":"We use AI where it looks right, such as motion graphics, backgrounds and variations, and a designer checks every frame."}},{"@type":"Question","name":"Do we need to film anything?","acceptedAnswer":{"@type":"Answer","text":"Not always. Many videos are made with motion graphics and AI, with no shoot needed."}},{"@type":"Question","name":"Which formats do you deliver?","acceptedAnswer":{"@type":"Answer","text":"Every size you need, wide, square and vertical, ready to publish."}},{"@type":"Question","name":"Who owns the work?","acceptedAnswer":{"@type":"Answer","text":"You do. You own everything we build."}},{"@type":"Question","name":"Can you write the script?","acceptedAnswer":{"@type":"Answer","text":"Yes. We write scripts and storyboards, or polish the ones you have."}},{"@type":"Question","name":"Do you add voiceovers and music?","acceptedAnswer":{"@type":"Answer","text":"Yes. Voiceovers, music and subtitles are part of the edit."}},{"@type":"Question","name":"How do you use AI in video?","acceptedAnswer":{"@type":"Answer","text":"AI speeds up scripts, visuals and edits. Our designers check every frame against your brand."}},{"@type":"Question","name":"How is the work priced?","acceptedAnswer":{"@type":"Answer","text":"With a fixed price agreed before we start, or a monthly plan. Start on a monthly plan or bring us a project."}}]}]}c:[["children",{"s":"__PAGE__","h":160,"d":{"r":["$","$3","c",{"children":[[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$d"}}],[["$","section",null,{"data-band":true,"className":"-mt-[var(--header-h)] bg-page pb-[clamp(40px,calc(2.3vw+31.4px),76px)] pt-[calc(var(--header-h)+clamp(40px,calc(1.57vw+34px),64px))]","children":[["$","div",null,{"className":"relative isolate","children":[["$","$L12",null,{"short":true}],["$","div",null,{"className":"@container flex flex-col items-center px-gutter text-center","children":[["$","p",null,{"className":"mb-[clamp(24px,calc(2.03vw+16.4px),55px)] rounded-[4px] border border-ink/25 px-[0.6em] py-[0.15em] text-base text-ink","children":"Create"}],["$","h1",null,{"className":"text-giant giant-wrap w-full font-bold uppercase","style":{"fontSize":"min(var(--text-giant), calc(100cqw / 6.507))"},"children":["$","span",null,{"data-reveal-mask":true,"className":"reveal-mask","children":["$","span",null,{"children":["AI Video ","$L13",""]}]}]}],"$L14",["$L15",""]]}]]}],"$L16"]}],"$L17","$L18",false,"$L19"]],["$L1a","$L1b"],"$L1c"]}],"p":"$@1d","v":null,"s":"$9"}}]]
