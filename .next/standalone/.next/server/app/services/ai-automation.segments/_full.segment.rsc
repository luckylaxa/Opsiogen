54:Ta27,{"@context":"https://schema.org","@graph":[{"@type":"Service","name":"AI Automation","description":"Less manual work. Faster operations. We find the repetitive tasks slowing your business down and automate them with AI, from lead handling and document processing to reports and approvals. Your tools work together, and your people get hours back every week.","url":"https://opsiogen.com/services/ai-automation","provider":{"@id":"https://opsiogen.com/#organization"}},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://opsiogen.com/"},{"@type":"ListItem","position":2,"name":"Services","item":"https://opsiogen.com/services"},{"@type":"ListItem","position":3,"name":"AI Automation","item":"https://opsiogen.com/services/ai-automation"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Will automation replace our people?","acceptedAnswer":{"@type":"Answer","text":"No. It takes repetitive work off their desks, and people still approve the decisions that matter."}},{"@type":"Question","name":"What can be automated?","acceptedAnswer":{"@type":"Answer","text":"Repetitive, rule-based work such as data entry, follow-ups, reports, approvals and document handling. A process audit shows where to start."}},{"@type":"Question","name":"Will it work with the tools we use?","acceptedAnswer":{"@type":"Answer","text":"We connect the tools you already have wherever they allow it, so your people don’t have to switch."}},{"@type":"Question","name":"What happens after launch?","acceptedAnswer":{"@type":"Answer","text":"The monthly care plan keeps your automations running and improving."}},{"@type":"Question","name":"Who owns the work?","acceptedAnswer":{"@type":"Answer","text":"You do. You own everything we build."}},{"@type":"Question","name":"Do we need technical staff?","acceptedAnswer":{"@type":"Answer","text":"No. We build, run and look after the automations. Your team just uses them."}},{"@type":"Question","name":"Can you build an AI voice assistant?","acceptedAnswer":{"@type":"Answer","text":"Yes. We build assistants that answer calls and questions, and hand over to your team when needed."}},{"@type":"Question","name":"How do we know what to automate first?","acceptedAnswer":{"@type":"Answer","text":"The process audit ranks tasks by time saved and effort, so you start where it pays back fastest."}},{"@type":"Question","name":"How is the work priced?","acceptedAnswer":{"@type":"Answer","text":"With a fixed price agreed before we start, or a monthly plan. Start on a monthly plan or bring us a project."}}]}]}e:[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$54"}}],[["$","section",null,{"data-band":true,"className":"-mt-[var(--header-h)] bg-page pb-[clamp(40px,calc(2.3vw+31.4px),76px)] pt-[calc(var(--header-h)+clamp(40px,calc(1.57vw+34px),64px))]","children":[["$","div",null,{"className":"relative isolate","children":[["$","$L55",null,{"short":true}],["$","div",null,{"className":"@container flex flex-col items-center px-gutter text-center","children":[["$","p",null,{"className":"mb-[clamp(24px,calc(2.03vw+16.4px),55px)] rounded-[4px] border border-ink/25 px-[0.6em] py-[0.15em] text-base text-ink","children":"Build"}],["$","h1",null,{"className":"text-giant giant-wrap w-full font-bold uppercase","style":{"fontSize":"min(var(--text-giant), calc(100cqw / 6.749))"},"children":"$L56"}],"$L57",["$L58",""]]}]]}],"$L59"]}],"$L5a","$L5b","$L5c","$L5d"]]
